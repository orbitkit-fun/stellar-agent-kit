# ─── Supabase (required) ──────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── AI providers (at least one required for the agent to work) ───────────────
GROQ_API_KEY=gsk_...
OPENAI_API_KEY=sk-...

# ─── Stellar / SoroSwap ───────────────────────────────────────────────────────
SOROSWAP_API_KEY=your-soroswap-api-key
STELLAR_DEVKIT_APP_ID=your-app-id

# ─── DodoPayments (required in production) ────────────────────────────────────
DODO_PAYMENTS_API_KEY=your-dodo-api-key
DODO_PAYMENTS_WEBHOOK_SECRET=your-webhook-secret
DODO_PAYMENTS_ENVIRONMENT=test
DODO_PAYMENTS_PRODUCT_BUILDER=your-product-id
DODO_PAYMENTS_PRODUCT_PRO=your-product-id

# ─── Auth / Security (required in production) ─────────────────────────────────
ADMIN_SECRET=change-this-in-production
SECRET_KEY=change-this-in-production

# ─── App URL ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
